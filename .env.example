# Arc Testnet
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc-node.thecanteenapp.com/v1/<key>
# Optional since v1.2.9.4: the service signs nothing with it. Only needed if you run forge/cast from this file; keep it out of the server .env.
DEPLOYER_PRIVATE_KEY=
AGENT_ADDRESS=
# Only recorded for the original business when the database is first created; the admin site checks the contract's approver().
APPROVER_ADDRESS=
USDC_ADDRESS=
BUDGET_ENFORCER_ADDRESS=
# Reserved for planned contracts (escrow, yield); no code reads them yet.
MILESTONE_ESCROW_ADDRESS=
CEEDEBOOKS_YIELD_ADDRESS=

# Circle
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_TREASURY_WALLET_ID=
CIRCLE_TREASURY_WALLET_ADDRESS=
# Reserved for the planned Gateway balance (Phase F); no code reads it yet.
GATEWAY_API_URL=https://gateway-api-testnet.circle.com

# AI models
GROQ_API_KEY=
GROQ_LLM_MODEL=openai/gpt-oss-120b

# Laya (not wired into decisions; no code reads these yet)
LAYA_MODEL=convaiinnovations/laya-typed-decisions
LAYA_FINETUNED_CHECKPOINT_PATH=

# CCTP (reserved: only needed once cross-chain vendor payments are built; no code reads these yet)
CCTP_ARC_DOMAIN=26
CCTP_MIN_FINALITY_THRESHOLD=2000

# Budget limits (reserved; the contract's own limits are what is enforced, and no code reads these yet)
DAILY_BUDGET_USDC=100.0
PER_TX_LIMIT_USDC=20.0
USYC_IDLE_THRESHOLD_DAYS=3

# App
BACKEND_URL=
CEEDEBOOKS_DB_PATH=./ceedebooks.db
# Signs the decision ledger (Ed25519 seed, 64 hex characters). Create it with: python3 scripts/ledger_key.py new --env .env
# It is not a wallet key and moves no money, but anyone holding it can forge ledger entries. Never commit it.
LEDGER_SIGNING_KEY=
# On-chain anchoring of each ledger head (v1.2.9.2). Leave off until each business's first anchor was sent by hand
# with scripts/anchor_ledger.py. LEDGER_ANCHOR_ADDRESS defaults to the deployed LedgerAnchor on Arc Testnet.
LEDGER_ANCHOR_AUTO=
#LEDGER_ANCHOR_ADDRESS=

# API hardening (all optional)
MAX_BODY_BYTES=
RATE_LIMIT_PER_MIN=
FAILED_AUTH_PER_MIN=
CORS_ORIGINS=
TRUST_PROXY=
ADMIN_ORIGIN=
PORTAL_ORIGIN=

# BudgetFactory (v1.2.8): businesses register through it. This is the deployed Arc Testnet address; only change it for a new deployment.
BUDGET_FACTORY_ADDRESS=0x97b9A3802bA6B258cBeF6070532a265656bb391C

# Ask the language model for a recorded second opinion on each decision (v1.2.9.3). It never acts; set 0 to turn it off.
MODEL_COMPARE=1
